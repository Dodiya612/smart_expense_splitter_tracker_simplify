PROJECT_NAME="Smart Expense Splitter Backend"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Local Docker PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker
#
# Supabase Session Pooler (port 5432):
# Format: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker

# CORS Configuration (JSON array of strings)
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://10.0.2.2:8081"]

# Authentication & Security Configuration (Phase 2)
# In production, JWT_SECRET_KEY must be a cryptographically random secret of at least 32 characters
JWT_SECRET_KEY=dev-secret-key-change-in-production-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=smart-expense-splitter
JWT_AUDIENCE=smart-expense-splitter-app

