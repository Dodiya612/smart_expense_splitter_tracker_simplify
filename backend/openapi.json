    "/api/v1/expenses": {
      "post": {
        "tags": [
          "Expenses"
        ],
        "summary": "Create a personal expense",
        "description": "Creates a new personal expense record for the authenticated user. Supports idempotent retries via the Idempotency-Key header.",
        "operationId": "create_expense_endpoint_api_v1_expenses_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseDataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "List personal expenses",
        "description": "Returns a paginated list of personal expenses owned by the authenticated user. Soft-deleted records are automatically excluded.",
        "operationId": "list_expenses_endpoint_api_v1_expenses_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by category UUID",
              "title": "Category Id"
            },
            "description": "Filter by category UUID"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter expenses on or after this date",
              "title": "From"
            },
            "description": "Filter expenses on or after this date"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter expenses on or before this date",
              "title": "To"
            },
            "description": "Filter expenses on or before this date"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search text in description or merchant",
              "title": "Q"
            },
            "description": "Search text in description or merchant"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page limit (1-100)",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page limit (1-100)"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Page offset",
              "default": 0,
              "title": "Offset"
            },
            "description": "Page offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/expenses/totals": {
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "Get personal expense spending totals",
        "description": "Calculates the total spending amount in integer paise for active personal expenses. Soft-deleted expenses are strictly excluded.",
        "operationId": "get_expense_totals_endpoint_api_v1_expenses_totals_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date for totals",
              "title": "From"
            },
            "description": "Start date for totals"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date for totals",
              "title": "To"
            },
            "description": "End date for totals"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseTotalResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/expenses/{expense_id}": {
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "Retrieve an expense by ID",
        "description": "Retrieves a single personal expense owned by the authenticated user. Accessing another user's expense or a deleted expense returns 404.",
        "operationId": "get_expense_endpoint_api_v1_expenses__expense_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "expense_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Expense Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseDataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Expenses"
        ],
        "summary": "Update an existing expense",
        "description": "Updates fields of an existing personal expense with optimistic concurrency. The client must supply the known version in the request body or via the If-Match header. Returns 409 Conflict if the version is stale.",
        "operationId": "update_expense_endpoint_api_v1_expenses__expense_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "expense_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Expense Id"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseDataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Expenses"
        ],
        "summary": "Soft delete an expense",
        "description": "Marks a personal expense as soft-deleted. The record remains stored in the database for auditability, but is excluded from ordinary queries and spending totals.",
        "operationId": "delete_expense_endpoint_api_v1_expenses__expense_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "expense_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Expense Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseDeleteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/expenses/{expense_id}/restore": {
      "post": {
        "tags": [
          "Expenses"
        ],
        "summary": "Restore a soft-deleted expense",
        "description": "Restores a previously soft-deleted personal expense, making it visible again in ordinary listings and spending totals.",
        "operationId": "restore_expense_endpoint_api_v1_expenses__expense_id__restore_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "expense_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Expense Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseRestoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenBundle"
          }
        },
        "type": "object",
        "required": [
          "user",
          "tokens"
        ],
        "title": "AuthResponse"
      },
      "ExpenseCreate": {
        "properties": {
          "amountMinor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amountminor",
            "description": "Amount in whole integer paise (strictly > 0)."
          },
          "amountPaise": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amountpaise",
            "description": "Alias for amount_minor in whole integer paise."
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Description",
            "description": "Brief description of the expense."
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "title": "Categoryid",
            "description": "UUID of the selected category."
          },
          "expenseDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expensedate",
            "description": "Date of the expense (YYYY-MM-DD). Defaults to current date."
          },
          "occurredOn": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurredon",
            "description": "Alias for expense_date matching API contracts."
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "Optional detailed notes."
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant",
            "description": "Optional merchant or vendor name."
          },
          "paymentMode": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Paymentmode",
            "description": "Optional payment mode, e.g. cash, upi, card, net_banking."
          },
          "receiptId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receiptid",
            "description": "Optional reference ID to an uploaded receipt."
          }
        },
        "type": "object",
        "required": [
          "description",
          "categoryId"
        ],
        "title": "ExpenseCreate",
        "description": "Payload for creating a personal expense."
      },
      "ExpenseDataResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ExpenseResponse"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ExpenseDataResponse",
        "description": "Standard envelope for a single expense: { \"data\": { ... } }."
      },
      "ExpenseDeleteResponse": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Expense deleted successfully."
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ExpenseDeleteResponse",
        "description": "Response returned upon soft deleting an expense."
      },
      "ExpenseListMeta": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "type": "object",
        "required": [
          "total",
          "limit",
          "offset"
        ],
        "title": "ExpenseListMeta",
        "description": "Metadata for paginated expense lists."
      },
      "ExpenseListResponse": {
        "properties": {
