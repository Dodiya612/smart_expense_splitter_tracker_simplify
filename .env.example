# ==============================================================================
# Coinscious - Environment Variables Example
# ==============================================================================
# IMPORTANT:
# - DO NOT commit real secrets or production credentials to version control.
# - Copy this file to .env for local development.
# - In production (Render, Vercel, GitHub Actions), configure these in the provider dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (Render / Local)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

# ------------------------------------------------------------------------------
# Database - PostgreSQL 16 on Supabase
# ------------------------------------------------------------------------------
# Use connection pooler (port 6543) for runtime queries:
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Use direct connection (port 5432) for schema migrations (Alembic):
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / Public Key (enforces Row Level Security):
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# Service Role Key (SERVER ONLY - NEVER expose to frontend or commit):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens (PyJWT):
JWT_SECRET=generate-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# External Services (GenAI & OCR)
# ------------------------------------------------------------------------------
# OCR.space receipt scanning:
OCR_SPACE_API_KEY=your-ocr-space-api-key-placeholder
# Groq AI assistant & fallback categorizer:
GROQ_API_KEY=gsk_your-groq-api-key-placeholder

# ------------------------------------------------------------------------------
# Frontend (Vercel) Environment Variables (When applicable)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=https://coinscious-backend.onrender.com/api/v1
# NEXT_PUBLIC_API_URL=https://coinscious-backend.onrender.com/api/v1
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
